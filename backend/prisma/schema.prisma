generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int         @id @default(autoincrement())
  name      String
  email     String      @unique
  password  String
  createdAt DateTime    @default(now()) @map("created_at")
  transaksi Transaksi[]
  anggaran  Anggaran[]

  @@map("users")
}

model Transaksi {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deskripsi String
  jumlah    Int
  jenis     Jenis
  kategori  String
  tanggal   DateTime
  createdAt DateTime @default(now()) @map("created_at")

  @@map("transaksi")
}

model Anggaran {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kategori  String
  batas     Int      // batas pengeluaran per bulan dalam rupiah
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, kategori])   // satu user hanya bisa punya 1 anggaran per kategori
  @@map("anggaran")
}

enum Jenis {
  pemasukan
  pengeluaran
}